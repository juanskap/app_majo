<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si se accede directamente a public/ no reescribir
    RewriteCond %{REQUEST_URI} (^|/)public/(.*)$ [NC]
    RewriteRule ^ - [L]

    # Redirigir la raíz hacia public/
    RewriteRule ^$ public/ [L]

    # Enrutar cualquier otra petición hacia public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule (.*) public/$1 [L]
</IfModule>

Options -Indexes